{
  "name": "aedos",
  "version": "1.0.0",
  "description": "Local web application that allows students to automatically generate academic presentations in PDF using the Google Gemini API.",
  "main": "src/backend/server.js",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "node --watch src/backend/server.js",
    "build": "node scripts/install-chrome.js",
    "postinstall": "node scripts/install-chrome.js"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@upstash/redis": "^1.37.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mammoth": "^1.12.0",
    "motion": "^12.35.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.39.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "yauzl": "^3.2.1"

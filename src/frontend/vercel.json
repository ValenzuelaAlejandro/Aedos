{
  "version": 2,
  "public": true,
  "name": "aedos-frontend",
  "rewrites": [
    {
      "source": "/(generate|finalize|download|__dev__)(.*)",
      "destination": "https://aedos-backend.onrender.com/$1$2"
    },
    {
      "source": "/",
      "destination": "/pages/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

# Backend safety limits (USD, spent from the server owner's OpenRouter balance)
PAID_SPEND_DAILY_USD=0.05
PAID_SPEND_MONTHLY_USD=1.00
PAID_BALANCE_FLOOR_USD=1.00
GEMINI_DAILY_APP_CAP=16
# Exposes NVIDIA Build trial models only on a local development server when configured.
# NVIDIA_API_KEY=
# OpenRouter reasoning controls; Haiku HTML defaults to none, other stages to low.
# OPENROUTER_REASONING_EFFORT_HTML=none
# OPENROUTER_REASONING_EFFORT_DESIGN=low
# OPENROUTER_REASONING_EFFORT_SCHEMA=low
# Optional: /api/v1/credits requires an OpenRouter management key.
# OPENROUTER_MANAGEMENT_KEY=

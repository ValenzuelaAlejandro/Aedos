# Copy to .env and set at least one provider API key.
NODE_ENV=development
PORT=3000
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Required for functional generation and credit accounting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required in production: comma-separated HTTPS origins, no trailing slash.
# ALLOWED_ORIGINS=https://your-domain.example
# OpenRouter sends this URL as HTTP-Referer when configured.
# APP_URL=https://your-domain.example

# Optional owner spending limits (USD) and Gemini daily app cap.
PAID_SPEND_DAILY_USD=0.25
PAID_SPEND_MONTHLY_USD=1.00
PAID_BALANCE_FLOOR_USD=1.00
GEMINI_DAILY_APP_CAP=16
# OPENROUTER_MANAGEMENT_KEY=

# Optional generation and export limits. Defaults shown below.
# GLOBAL_DAILY_GENERATION_LIMIT=100
# LIMITS_FINALIZE_MAX=10
# LIMITS_FLASH_COOLDOWN_SEC=0
# LIMITS_PRO_COOLDOWN_SEC=0
# LIMITS_OUTLINE_COOLDOWN_SEC=0
# LIMITS_CHAT_COOLDOWN_SEC=0
# MAX_CONCURRENT_GENERATIONS=10
# MAX_QUEUE_DEPTH=40
# PUPPETEER_MAX_CONCURRENT=3
# PUPPETEER_MAX_QUEUE=10

# Optional OpenRouter reasoning controls. HTML defaults to none.
# OPENROUTER_REASONING_FLASH=low
# OPENROUTER_REASONING_EFFORT_HTML=none
# OPENROUTER_REASONING_EFFORT_DESIGN=low
# OPENROUTER_REASONING_EFFORT_SCHEMA=low
